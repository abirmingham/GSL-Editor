{
    "name": "gsl-investigator",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "build": "tsc",
        "watch": "tsc --watch",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"main.ts\" \"loggerDaemon.ts\" \"discord-tools-mcp.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"main.ts\" \"loggerDaemon.ts\" \"discord-tools-mcp.ts\"",
        "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"main.ts\" \"loggerDaemon.ts\" \"discord-tools-mcp.ts\"",
        "lint:fix": "eslint --fix \"src/**/*.ts\" \"tests/**/*.ts\" \"main.ts\" \"loggerDaemon.ts\" \"discord-tools-mcp.ts\"",
        "test": "vitest run"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "discord.js": "^14.26.4",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^20.4.5",
        "@types/ws": "^8.18.1",
        "@typescript-eslint/eslint-plugin": "^8.60.0",
        "@typescript-eslint/parser": "^8.60.0",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.8.3",
        "typescript": "^5.1.6",
        "vitest": "^4.1.7"
    }
}
